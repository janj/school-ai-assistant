# Copy to .env for local runs. On the server, deploy.sh creates /opt/school-ai/.env itself.
# Never commit a real .env.

# Required. Anthropic API key.
ANTHROPIC_API_KEY=

# Models: Sonnet writes answers, Haiku scrubs PII / rewrites follow-ups.
ANSWER_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-4-5-20251001

# SQLite file. Defaults to data/school.db locally; Docker sets /app/data/school.db (a named volume).
# DB_PATH=data/school.db

# Signs the session cookie. Must be a long random string in production
# (e.g. `openssl rand -hex 32`).
SESSION_SECRET=dev-only-not-secret

# Per-IP limits (kept in memory only).
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_S=300
TOKEN_BUDGET_SHORT=60000
TOKEN_BUDGET_SHORT_WINDOW_S=600
TOKEN_BUDGET_DAILY=300000

# Conversations (app/history.py): a thread idle this long starts fresh (default 30 min).
# History is in memory only; 4 turns are sent to the model and 8 are allowed per thread.
CONVERSATION_IDLE_SECONDS=1800

# Docker/Caddy only (not read by app/config.py): public hostname,
# e.g. 203-0-113-7.sslip.io. Use localhost for a local run.
DOMAIN=localhost
